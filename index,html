    rr(s.x-38,jy-106,76,16,5,'#c9854a');line(s.x-20,jy-80,s.x-20,jy-30,'rgba(255,255,255,.8)',4);
  }
});

// 20. Cổng không gian
add('Cổng không gian','🌀',(t,s)=>{
  const f=s.fx,p=ease(seg(t,1.2,3.4));f.arms=1;
  if(t>=1.2){f.ox=p*145;f.clipX=s.x+110;f.rot=-p*.25;f.noTag=p>.4;}
},(t,s)=>{
  const g=ease(seg(t,0,1))*(1-ease(seg(t,4.4,5.2)));if(g<.02)return;
  const px=s.x+110,py=s.y-55;
  ell(px,py,34*g,78*g,'rgba(120,60,220,.35)');ell(px,py,14*g,52*g,'#12062b');
  ctx.save();ctx.lineWidth=6;
  for(let k=0;k<3;k++){ctx.strokeStyle=['#c9a0ff','#6ee7ff','#ff8ad8'][k];ctx.setLineDash([14,10]);ctx.lineDashOffset=-t*(40+k*20)*(k%2?-1:1);
    ctx.beginPath();ctx.ellipse(px,py,(24-k*5)*g,(68-k*11)*g,0,0,7);ctx.stroke();}
  ctx.restore();
  for(let i=0;i<12;i++){const a=t*3+i*.52;circ(px+Math.cos(a)*38*g,py+Math.sin(a)*80*g,2.5,'#e9d5ff');}
});

// ---------- wheel ----------
const SLICE=Math.PI*2/D.length;
function drawWheel(angle){
  const cx=260,cy=260,r=245;
  wctx.clearRect(0,0,520,520);
  wctx.save();wctx.translate(cx,cy);wctx.rotate(angle);
  for(let i=0;i<D.length;i++){
    const a=-Math.PI/2+i*SLICE;
    wctx.beginPath();wctx.moveTo(0,0);wctx.arc(0,0,r,a,a+SLICE);wctx.closePath();
    wctx.fillStyle='hsl('+(i*18)+',80%,68%)';wctx.fill();wctx.strokeStyle='#fff';wctx.lineWidth=3;wctx.stroke();
    wctx.save();wctx.rotate(a+SLICE/2);wctx.translate(r*.8,0);wctx.rotate(Math.PI/2);
    wctx.font='30px serif';wctx.textAlign='center';wctx.fillText(D[i].icon,0,10);wctx.restore();
  }
  wctx.beginPath();wctx.arc(0,0,r,0,7);wctx.strokeStyle='#fff';wctx.lineWidth=8;wctx.stroke();
  wctx.beginPath();wctx.arc(0,0,28,0,7);wctx.fillStyle='#ffd76b';wctx.fill();wctx.strokeStyle='#fff';wctx.lineWidth=5;wctx.stroke();
  wctx.restore();
}
drawWheel(0);

function setLock(v){startBtn.disabled=v;namesEl.disabled=v;document.getElementById('count').disabled=v;}
function startRound(){
  if(!students.length){alert('Hãy nhập ít nhất một tên học sinh!');return;}
  if(scene||spinning)return;
  setLock(true);spinning=true;overlay.classList.add('show');
  const status=document.getElementById('spinStatus');status.textContent='Đang quay...';
  const idx=Math.floor(Math.random()*D.length);
  const target=((Math.PI*2-(idx+.5)*SLICE)%(Math.PI*2));
  const cur=((wheelAngle%(Math.PI*2))+Math.PI*2)%(Math.PI*2);
  const delta=(target-cur+Math.PI*2)%(Math.PI*2);
  const total=delta+Math.PI*2*6,start=wheelAngle,dur=4000,t0=performance.now();
  (function frame(now){
    const p=Math.min(1,(now-t0)/dur);
    wheelAngle=start+total*(1-Math.pow(1-p,4));drawWheel(wheelAngle);
    if(p<1){requestAnimationFrame(frame);return;}
    status.textContent=D[idx].icon+' '+D[idx].name;
    setTimeout(()=>{overlay.classList.remove('show');spinning=false;playScene(idx);},1000);
  })(t0);
}
startBtn.addEventListener('click',startRound);

function playScene(idx){
  const n=Math.min(Number(document.getElementById('count').value)||1,students.length);
  const targets=[...students].sort(()=>Math.random()-.5).slice(0,n);
  targets.forEach(s=>{s.busy=true;s.moving=false;});
  round++;document.getElementById('roundCount').textContent=round;
  resTitle.textContent=D[idx].icon+' '+D[idx].name;
  resText.textContent='Đang bắt: '+targets.map(s=>s.name).join(', ')+'...';
  scene={d:D[idx],time:0,dur:6.5+(n-1)*.6,targets};
}
function finishScene(){
  const names=scene.targets.map(s=>s.name).join(', ');
  scene.targets.forEach(s=>{s.busy=false;s.x=rand(80,880);s.y=rand(345,500);s.spawn=1.2;s.wait=.5;pickTarget(s);});
  resTitle.textContent='🎯 '+names;
  resText.textContent='đã bị '+scene.d.name+' bắt đi! (và đã quay lại sân trường)';
  scene=null;setLock(false);
}

// ---------- main loop ----------
function render(now){
  requestAnimationFrame(render);
  const dt=Math.min(.04,(now-lastT)/1000||0);lastT=now;sceneTime+=dt;
  shkNow=shk;shk=0;
  updateWalk(dt);
  students.forEach(s=>{if(s.spawn>0)s.spawn=Math.max(0,s.spawn-dt);s.fx=freshFx(s);});
  if(scene)scene.time+=dt;
  ctx.save();
  if(shkNow>0.1)ctx.translate(rand(-shkNow,shkNow),rand(-shkNow,shkNow));
  drawBackground(sceneTime);
  const order=[...students].sort((a,b)=>a.y-b.y);
  order.forEach(s=>{
    const i=scene?scene.targets.indexOf(s):-1;
    if(i>=0){s.lt=Math.max(0,scene.time-i*.6);scene.d.back(s.lt,s);}
    drawStudent(s);
    if(i>=0)scene.d.front(s.lt,s);
  });
  ctx.restore();
  if(scene&&scene.time>scene.dur)finishScene();
}
requestAnimationFrame(render);
</script>
