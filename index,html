<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vòng Quay Thảm Họa</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:14px;min-height:100vh;color:#f3f8ff;font-family:"Segoe UI",Arial,sans-serif;background:linear-gradient(145deg,#101d35,#1b3554)}
.page{max-width:1100px;margin:auto}
h1{text-align:center;margin:4px 0 12px;font-size:clamp(22px,4vw,34px)}
.layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:12px;align-items:start}
.panel{background:#1c3152;border:1px solid #5d8fba55;border-radius:14px;padding:14px}
label{display:block;font-size:13px;color:#c3d7ee;margin:10px 0 5px}
textarea,select{width:100%;border:1px solid #6596c6;border-radius:9px;padding:9px;color:#f5faff;background:#10243e;font:inherit}
textarea{height:190px;resize:vertical;line-height:1.5}
button{width:100%;margin-top:12px;border:0;border-radius:10px;padding:13px;font-weight:800;font-size:15px;cursor:pointer;color:#42152c;background:linear-gradient(135deg,#ffb0ce,#ff6f9e)}
button:disabled{opacity:.5;cursor:not-allowed}
.count{margin-top:10px;font-size:13px;color:#b9cbe2}
.stage-wrap{position:relative;border-radius:12px;overflow:hidden;background:#9bd8f4}
canvas{display:block;width:100%;height:auto;aspect-ratio:16/9}
.result{margin-top:10px;padding:12px;border-radius:12px;text-align:center;background:#132b49;border:1px solid #6ba9d855}
.result h2{margin:0 0 4px;color:#ffda79;font-size:clamp(18px,3vw,25px)}
.result p{margin:0;color:#d6e8fa}
.overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:#07172ccc}
.overlay.show{display:flex}
.wheel-card{text-align:center;padding:12px}
.wheel-box{position:relative;width:min(62vw,330px);margin:auto}
#wheel{width:100%;height:auto;display:block}
.pointer{position:absolute;z-index:2;top:-8px;left:50%;transform:translateX(-50%);border-left:14px solid transparent;border-right:14px solid transparent;border-top:30px solid #fff2a0;filter:drop-shadow(0 3px 3px #000)}
#spinStatus{margin-top:8px;font-weight:800;color:#ffe08a;min-height:24px}
@media(max-width:820px){.layout{grid-template-columns:1fr}.panel{order:2}}
</style>
</head>
<body>
<div class="page">
<h1>🎡 VÒNG QUAY THẢM HỌA</h1>
<div class="layout">
  <aside class="panel">
    <label for="names">Tên học sinh (mỗi tên một dòng)</label>
    <textarea id="names"></textarea>
    <label for="count">Số học sinh bị chọn mỗi lượt</label>
    <select id="count"><option>1</option><option>2</option><option>3</option></select>
    <button id="startBtn">🎡 QUAY!</button>
    <div class="count">👥 <span id="studentCount">0</span> học sinh · 🌪️ 20 thảm họa · 🎯 Lượt: <span id="roundCount">0</span></div>
  </aside>
  <main>
    <div class="stage-wrap">
      <canvas id="game" width="960" height="540"></canvas>
      <div class="overlay" id="overlay">
        <div class="wheel-card">
          <div class="wheel-box"><div class="pointer"></div><canvas id="wheel" width="520" height="520"></canvas></div>
          <div id="spinStatus"></div>
        </div>
      </div>
    </div>
    <div class="result"><h2 id="resTitle">Sẵn sàng!</h2><p id="resText">Nhập tên học sinh rồi bấm QUAY.</p></div>
  </main>
</div>
</div>

<script>
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
const wheelCv=document.getElementById('wheel'),wctx=wheelCv.getContext('2d');
const namesEl=document.getElementById('names'),countEl=document.getElementById('studentCount');
const startBtn=document.getElementById('startBtn'),overlay=document.getElementById('overlay');
const resTitle=document.getElementById('resTitle'),resText=document.getElementById('resText');

// ---------- helpers ----------
const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));
const seg=(t,a,b)=>clamp((t-a)/(b-a));
const ease=p=>p*p*(3-2*p);
const lerp=(a,b,p)=>a+(b-a)*p;
const rand=(a,b)=>a+Math.random()*(b-a);
const hh=i=>{const x=Math.sin(i*127.1+311.7)*43758.5453;return x-Math.floor(x);};
const noop=()=>{};
function circ(x,y,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.arc(x,y,Math.max(0,r),0,7);ctx.fill();}
function ell(x,y,rx,ry,c){ctx.fillStyle=c;ctx.beginPath();ctx.ellipse(x,y,Math.max(0,rx),Math.max(0,ry),0,0,7);ctx.fill();}
function poly(p,c){ctx.fillStyle=c;ctx.beginPath();p.forEach((q,i)=>i?ctx.lineTo(q[0],q[1]):ctx.moveTo(q[0],q[1]));ctx.closePath();ctx.fill();}
function line(x1,y1,x2,y2,c,w){ctx.strokeStyle=c;ctx.lineWidth=w;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();}
function rr(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill();}
function emoji(s,x,y,size){ctx.font=size+'px serif';ctx.textAlign='center';ctx.fillStyle='#000';ctx.fillText(s,x,y);}
function cloud(x,y,k,c){ctx.fillStyle=c;ctx.beginPath();ctx.arc(x,y,22*k,0,7);ctx.arc(x+23*k,y-10*k,27*k,0,7);ctx.arc(x+50*k,y,21*k,0,7);ctx.arc(x+25*k,y+8*k,25*k,0,7);ctx.fill();}
function bolt(x1,y1,x2,y2,seed){ctx.strokeStyle='#fffbd0';ctx.lineWidth=6;ctx.lineJoin='round';ctx.shadowColor='#ffe45e';ctx.shadowBlur=18;ctx.beginPath();ctx.moveTo(x1,y1);for(let i=1;i<7;i++){const k=i/7;ctx.lineTo(lerp(x1,x2,k)+(hh(seed+i)-.5)*46,lerp(y1,y2,k));}ctx.lineTo(x2,y2);ctx.stroke();ctx.shadowBlur=0;}

// ---------- students ----------
let students=[],scene=null,spinning=false,wheelAngle=0,round=0,sceneTime=0,lastT=0,shk=0,shkNow=0,idc=0;
const SHIRT=['#ff8e9e','#76baff','#ffd16e','#8fe0b0','#c19aff','#ffad75','#73d7d9'];
const HAIR=['#49382f','#2b2b33','#7a4a2a','#b0763a','#1f1f1f'];
function makeStudent(name){
  const i=idc++;
  const s={id:i,name,x:rand(80,880),y:rand(345,500),dir:1,phase:rand(0,6),speed:rand(35,70),wait:rand(0,1.5),moving:false,busy:false,spawn:0,
    color:SHIRT[i%SHIRT.length],hair:HAIR[i%HAIR.length],tx:0,ty:0,fx:null,lt:0};
  pickTarget(s);return s;
}
function pickTarget(s){s.tx=rand(60,900);s.ty=rand(345,500);}
function syncStudents(){
  const names=[...new Set(namesEl.value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean))].slice(0,24);
  const old=new Map(students.map(s=>[s.name,s]));
  students=names.map(n=>old.get(n)||makeStudent(n));
  countEl.textContent=students.length;
}
namesEl.addEventListener('input',syncStudents);
namesEl.value='Nguyễn Văn An\nTrần Thị Bình\nLê Hoàng Minh\nPhạm Ngọc Hà\nVõ Gia Huy\nĐặng Khánh Linh\nBùi Quốc Bảo\nPhan Thảo Vy';
syncStudents();

function updateWalk(dt){
  students.forEach(s=>{
    if(s.busy){s.moving=false;return;}
    if(s.wait>0){s.wait-=dt;s.moving=false;return;}
    const dx=s.tx-s.x,dy=s.ty-s.y,d=Math.hypot(dx,dy);
    if(d<4){s.wait=rand(.3,2);pickTarget(s);s.moving=false;return;}
    s.x+=dx/d*s.speed*dt;s.y+=dy/d*s.speed*dt;
    if(Math.abs(dx)>3)s.dir=dx>0?1:-1;
    s.phase+=dt*s.speed*.14;s.moving=true;
  });
}
function freshFx(s){
  let a=1,k=1;
  if(s.spawn>0){const p=1-s.spawn/1.2;a=p;k=.6+.4*p;}
  return {ox:0,oy:0,rot:0,sx:k,sy:k,a,flt:'',arms:0,clip:null,clipX:null,noTag:false};
}

function drawStudent(s){
  const f=s.fx,sc=.85+.2*clamp((s.y-340)/170);
  if(f.clip==null&&f.clipX==null&&f.a>.02){
    const h=Math.max(0,-f.oy),k=Math.max(.25,1-h/260);
    ctx.save();ctx.globalAlpha=.22*f.a*k;ctx.fillStyle='#000';ctx.beginPath();
    ctx.ellipse(s.x+f.ox*.9,s.y+2,20*sc*k*f.sx,6*sc*k,0,0,7);ctx.fill();ctx.restore();
  }
  ctx.save();
  ctx.globalAlpha=f.a;
  if(f.flt)ctx.filter=f.flt;
  if(f.clip!=null||f.clipX!=null){ctx.beginPath();ctx.rect(0,0,f.clipX!=null?f.clipX:960,f.clip!=null?f.clip:540);ctx.clip();}
  ctx.translate(s.x+f.ox,s.y+f.oy);ctx.scale(sc,sc);
  ctx.translate(0,-45);ctx.rotate(f.rot);ctx.translate(0,45);
  ctx.scale(f.sx,f.sy);ctx.scale(s.dir,1);
  const bob=s.moving?Math.abs(Math.sin(s.phase))*2:Math.sin(sceneTime*3+s.id)*1;
  ctx.translate(0,-bob);
  let sw=s.moving?Math.sin(s.phase)*8:0;
  if(f.arms)sw=Math.sin(sceneTime*20+s.id)*5;
  line(-5,-28,-5+sw,-4,'#34465c',7);line(5,-28,5-sw,-4,'#34465c',7);
  ell(-4+sw,-3,6,3,'#f4f4f4');ell(6-sw,-3,6,3,'#f4f4f4');
  rr(-22,-58,9,26,4,'#805b68');
  rr(-13,-63,26,38,8,s.color);
  if(f.arms){
    const w=Math.sin(sceneTime*14+s.id)*4;
    line(-12,-56,-20+w,-88,'#f2bd91',6);line(12,-56,20-w,-88,'#f2bd91',6);
  }else{
    const aw=s.moving?Math.sin(s.phase)*9:0;
    line(-13,-56,-14+aw*.5,-33,'#f2bd91',6);line(13,-56,14-aw*.5,-33,'#f2bd91',6);
  }
  circ(0,-78,14,'#f4c7a1');
  ctx.fillStyle=s.hair;ctx.beginPath();ctx.arc(0,-80,14.5,Math.PI,0);ctx.fill();ctx.fillRect(-14.5,-82,5,11);
  circ(6,-77,2,'#27354b');
  if(f.arms){ctx.strokeStyle='#27354b';ctx.lineWidth=1.6;ctx.beginPath();ctx.arc(7,-71,2.6,0,7);ctx.stroke();}
  else{ctx.strokeStyle='#27354b';ctx.lineWidth=1.6;ctx.beginPath();ctx.arc(6,-73,3,.2,Math.PI-.5);ctx.stroke();}
  ctx.restore();
  // name tag
  if(f.a>.05&&!f.noTag){
    ctx.save();ctx.globalAlpha=f.a;
    const label=s.name.length>14?s.name.slice(0,13)+'…':s.name;
    ctx.font='bold 12px Arial';ctx.textAlign='center';
    const w=ctx.measureText(label).width+14;
    const tx=clamp(s.x+f.ox,w/2,960-w/2),ty=Math.max(14,s.y+f.oy-(100*sc*f.sy)-6);
    ctx.fillStyle=s.busy?'#ffd76bee':'#183451cc';ctx.beginPath();ctx.roundRect(tx-w/2,ty-14,w,19,7);ctx.fill();
    ctx.fillStyle=s.busy?'#3a2a05':'#fff';ctx.fillText(label,tx,ty);
    ctx.restore();
  }
}

// ---------- background ----------
function drawBackground(t){
  const g=ctx.createLinearGradient(0,0,0,540);
  g.addColorStop(0,'#79c8f2');g.addColorStop(.55,'#c7e9f7');g.addColorStop(1,'#f3dfb0');
  ctx.fillStyle=g;ctx.fillRect(0,0,960,540);
  for(let i=0;i<4;i++)cloud(((i*270+t*6)%1150)-100,60+(i%3)*32,1+(i%2)*.2,'rgba(255,255,255,.7)');
  ctx.fillStyle='#8dc58e';ctx.beginPath();ctx.moveTo(0,320);ctx.quadraticCurveTo(200,250,380,320);ctx.quadraticCurveTo(620,255,800,315);ctx.quadraticCurveTo(900,280,960,310);ctx.lineTo(960,420);ctx.lineTo(0,420);ctx.fill();
  // school
  ctx.fillStyle='#f3bd78';ctx.fillRect(260,150,440,165);
  poly([[230,155],[480,62],[730,155]],'#d66f61');
  ctx.fillStyle='#fff0cf';ctx.fillRect(285,180,390,135);
  rr(438,228,84,87,3,'#e78d68');
  for(const x of [315,390,570,645]){ctx.fillStyle='#7ac5df';ctx.fillRect(x,195,48,50);}
  rr(400,115,160,28,8,'#fff0cf');ctx.fillStyle='#8e4f44';ctx.font='bold 15px Arial';ctx.textAlign='center';ctx.fillText('TRƯỜNG HỌC',480,135);
  line(760,105,760,315,'#e9edf3',5);ctx.fillStyle='#e84d4d';ctx.fillRect(763,108,70,42);
  for(const x of [80,160,800,880]){ctx.fillStyle='#805b43';ctx.fillRect(x-8,255,16,95);circ(x,245,36,'#399b68');circ(x-20,262,24,'#399b68');circ(x+21,262,24,'#399b68');}
  ctx.fillStyle='#d9c99a';ctx.fillRect(0,315,960,225);
  ctx.fillStyle='#a6cb8c';ctx.fillRect(0,315,960,18);
  ctx.fillStyle='#d8a76f';ctx.fillRect(0,440,960,100);
}

// ---------- disasters ----------
const D=[];
const add=(name,icon,back,front)=>D.push({name,icon,back:back||noop,front:front||noop});

// 1. UFO
const ufoPos=(t,s)=>{const d=seg(t,4.3,5.4);return{x:s.x+d*400,y:lerp(-60,95,ease(seg(t,0,1)))-d*220+Math.sin(t*3)*4};};
add('UFO bắt cóc','🛸',(t,s)=>{
  const f=s.fx,u=ufoPos(t,s);
  const a=seg(t,.8,1.2)*(1-seg(t,4,4.6));
  if(a>0){const g=ctx.createLinearGradient(0,u.y,0,s.y);g.addColorStop(0,'rgba(140,255,255,.7)');g.addColorStop(1,'rgba(140,255,255,.12)');
    ctx.save();ctx.globalAlpha=a;ctx.fillStyle=g;ctx.beginPath();ctx.moveTo(u.x-22,u.y+10);ctx.lineTo(u.x+22,u.y+10);ctx.lineTo(s.x+60,s.y+8);ctx.lineTo(s.x-60,s.y+8);ctx.closePath();ctx.fill();ctx.restore();}
  const p=ease(seg(t,1.3,4));
  f.arms=1;f.oy=-(s.y-u.y-20)*p;f.sx=f.sy=1-.75*p;f.rot=p*5;f.a=1-seg(t,3.6,4.1);
},(t,s)=>{
  const u=ufoPos(t,s);
  ell(u.x,u.y,66,17,'#6d86a4');
  ctx.fillStyle='#dff8ff';ctx.beginPath();ctx.ellipse(u.x,u.y-5,34,22,0,Math.PI,Math.PI*2);ctx.fill();
  ell(u.x,u.y+2,48,8,'#4be6ff');
  for(let i=0;i<7;i++)circ(u.x-42+i*14,u.y+6,3.5,i%2?'#fff49a':'#fff');
});

// 2. Lốc xoáy
const tornX=(t,s)=>t<4?lerp(s.x+420,s.x,ease(seg(t,0,1.6))):s.x+(t-4)*400;
add('Lốc xoáy','🌪️',(t,s)=>{
  const f=s.fx,p=ease(seg(t,1.6,4.6));f.arms=1;
  if(t>=1.6){f.ox=tornX(t,s)-s.x+Math.sin(t*9)*22*p;f.oy=-p*230;f.rot=(t-1.6)*13;f.a=1-seg(t,4.4,5.3);}
},(t,s)=>{
  const tx=tornX(t,s);
  ctx.save();ctx.globalAlpha=seg(t,0,.6)*.75;
  for(let i=0;i<10;i++){const w=14+i*9.5;ell(tx+Math.sin(t*7+i*.7)*7,s.y-i*21,w,w*.22,i%2?'#cfe0ec':'#9bb4c7');}
  for(let i=0;i<8;i++){const a=t*6+i*.8,r=24+i*9;circ(tx+Math.cos(a)*r,s.y-10-i*23+Math.sin(a)*6,3,'#6e8a3a');}
  ctx.restore();
});

// 3. Sóng thần
add('Sóng thần','🌊',(t,s)=>{
  const f=s.fx,xw=lerp(1150,-380,seg(t,.3,3.6)),hit=xw+40<s.x;
  f.arms=1;
  if(hit){f.ox=xw+40-s.x;f.oy=-25+Math.sin(t*8)*10;f.rot=t*6;}
  f.a=1-seg(t,3.2,3.7);
},(t,s)=>{
  if(t>4.2)return;
  const x=lerp(1150,-380,seg(t,.3,3.6));
  const g=ctx.createLinearGradient(0,220,0,540);g.addColorStop(0,'rgba(80,170,255,.85)');g.addColorStop(1,'rgba(30,110,210,.9)');
  ctx.fillStyle=g;ctx.beginPath();ctx.moveTo(x,560);ctx.lineTo(x,370);
  ctx.bezierCurveTo(x,260,x+80,215,x+150,235);ctx.bezierCurveTo(x+130,270,x+170,300,x+250,310);
  ctx.lineTo(x+420,320);ctx.lineTo(x+420,560);ctx.closePath();ctx.fill();
  for(let i=0;i<8;i++)circ(x+20+i*17+Math.sin(t*8+i)*4,235+Math.abs(i-3)*9+Math.sin(t*6+i)*4,7,'#e9fbff');
});

// 4. Thiên thạch
add('Thiên thạch','☄️',(t,s)=>{
  const f=s.fx;
  if(t<1.5){f.arms=1;return;}
  const cr=seg(t,1.5,1.7)*(1-seg(t,4.6,5.6));
  ell(s.x,s.y+2,44*cr,12*cr,'#5a3d2b');
  shk=Math.max(shk,t<1.9?9:0);
  const up=ease(seg(t,3.7,4.3));
  f.sy=lerp(.2,1,up);f.sx=lerp(1.4,1,up);f.flt=up<1?'sepia(.6) brightness(.65)':'';
},(t,s)=>{
  if(t<1.5){const p=t/1.5,x=lerp(s.x+420,s.x,p),y=lerp(-60,s.y-30,p);
    line(x,y,x+90,y-120,'rgba(255,170,90,.8)',16);circ(x,y,20,'#ff7847');circ(x-5,y-5,9,'#ffd58b');}
  else if(t<2.2){const r=20+(t-1.5)*320,a=1-(t-1.5)/.7;ctx.save();ctx.globalAlpha=a;
    ctx.strokeStyle='#ffb36b';ctx.lineWidth=8;ctx.beginPath();ctx.ellipse(s.x,s.y,r,r*.3,0,0,7);ctx.stroke();circ(s.x,s.y-20,40*a,'#fff2b0');ctx.restore();}
  if(t>1.7&&t<4.4)for(let i=0;i<3;i++){const a=t*5+i*2.1;emoji('⭐',s.x+Math.cos(a)*22,s.y-18+Math.sin(a)*5,18);}
});

// 5. Đóng băng
add('Bão tuyết đóng băng','❄️',(t,s)=>{
  const f=s.fx;
  if(t<1.2){f.ox=Math.sin(t*50)*1.5;f.arms=1;}
  else if(t<4.6)f.flt='saturate(.4) hue-rotate(160deg) brightness(1.2)';
},(t,s)=>{
  if(t<4.6)for(let i=0;i<30;i++){const x=s.x+(hh(i)-.5)*280+Math.sin(t*2+i)*10,y=s.y-260+((t*80+hh(i+9)*300)%300);circ(x,y,2.5,'#fff');}
  if(t>=1&&t<4.6){const g=ease(seg(t,1,1.8));
    ctx.save();ctx.fillStyle='rgba(170,230,255,.55)';ctx.strokeStyle='rgba(255,255,255,.9)';ctx.lineWidth=3;
    ctx.beginPath();ctx.roundRect(s.x-36,s.y+4-118*g,72,118*g,10);ctx.fill();ctx.stroke();
    if(g>.9){line(s.x-20,s.y-100,s.x-6,s.y-60,'#fff',2);line(s.x+10,s.y-90,s.x+22,s.y-40,'#fff',2);}
    if(t>4){line(s.x-30,s.y-30,s.x+30,s.y-80,'#fff',3);line(s.x+30,s.y-30,s.x-30,s.y-90,'#fff',3);}
    ctx.restore();}
  if(t>=4.6){const k=t-4.6,a=1-seg(t,4.6,5.6);
    for(let i=0;i<12;i++){const an=i*.52,d=k*(120+hh(i)*120);ctx.save();ctx.globalAlpha=a;
      poly([[s.x+Math.cos(an)*d,s.y-55+Math.sin(an)*d+k*k*120],[s.x+Math.cos(an)*d+12,s.y-55+Math.sin(an)*d+k*k*120+4],[s.x+Math.cos(an)*d+4,s.y-55+Math.sin(an)*d+k*k*120+14]],'#bfeaff');ctx.restore();}}
});

// 6. Sấm sét
const flashOn=t=>(t>1.6&&t<1.78)||(t>2.5&&t<2.62);
add('Sét đánh','⚡',(t,s)=>{
  const f=s.fx;
  if(t<1.6)f.arms=1;
  if(flashOn(t))f.flt='invert(1)';
  else if(t>=1.78&&t<4.2){f.flt='brightness(.22)';f.ox=t<3?Math.sin(t*50)*2:0;}
},(t,s)=>{
  const cs=ease(seg(t,0,.8))*(1-seg(t,4.4,5));
  if(cs>.01){ctx.save();ctx.globalAlpha=cs;cloud(s.x-25,70,1.5,'#4a5568');ctx.restore();}
  if(t>.8&&t<4.6)for(let i=0;i<14;i++){const x=s.x-60+hh(i)*130,y=100+((t*400+hh(i+5)*300)%(s.y-100));line(x,y,x-4,y+12,'#9fd0ff',2);}
